# GEMINI_API_KEY: Required for server-side Thai psychological reading & voice narration via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for canonical URLs, SEO sitemaps, and LINE external links).
APP_URL="MY_APP_URL"

# 3-Domain Host Mapping (swap placeholders to your real Cloudflare custom domains with zero code changes)
DOMAIN_HOROSCOPE="duangtok.example.com"
DOMAIN_TAROT="greypilgrim.example.com"
DOMAIN_DREAM="fanrai.example.com"
VITE_DOMAIN_HOROSCOPE="duangtok.example.com"
VITE_DOMAIN_TAROT="greypilgrim.example.com"
VITE_DOMAIN_DREAM="fanrai.example.com"

# Server-Side Access Gate & PromptPay Checkout Secrets (never expose with VITE_)
IP_HASH_SALT="replace-with-random-server-salt"
TOKEN_SIGNING_SECRET="replace-with-random-hmac-secret"
PROMPTPAY_ID="0812345678"
PROMPTPAY_WEBHOOK_SECRET="replace-with-promptpay-webhook-hmac-secret"

# Optional Cloudflare Workers / D1 / KV Native Persistence Cutover
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
