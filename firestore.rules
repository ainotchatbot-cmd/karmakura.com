rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLens(lens) {
      return lens is string && lens in ['buddhist', 'islamic', 'chinese', 'christian', 'jewish', 'thai_folk'];
    }

    function isValidDomainSlot(slot) {
      return slot is string && slot in ['slot_horoscope', 'slot_tarot', 'slot_dream'];
    }

    function isValidTimeframe(tf) {
      return tf is string && tf in ['daily', 'weekly', 'monthly', 'yearly'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLens', 'pdpaAccepted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredLens', 'pdpaAccepted', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidLens(data.preferredLens)
        && data.pdpaAccepted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAbbotThread(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'domainSlot', 'depthMode', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'domainSlot', 'depthMode', 'messageCount', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && isValidDomainSlot(data.domainSlot)
        && data.depthMode is string && data.depthMode in ['quick', 'balanced', 'deep']
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAbbotMessage(data, userId, threadId) {
      return data.keys().hasAll(['ownerId', 'threadId', 'role', 'modality', 'text', 'lens', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'threadId', 'role', 'modality', 'text', 'lens', 'createdAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.threadId is string && data.threadId.size() >= 1 && data.threadId.size() <= 128 && data.threadId == threadId
        && data.role is string && data.role in ['user', 'abbot']
        && data.modality is string && data.modality in ['text', 'voice', 'transcript']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && isValidLens(data.lens)
        && data.createdAt is timestamp;
    }

    function isValidSavedReading(data, userId) {
      return data.keys().hasAll(['ownerId', 'domainSlot', 'timeframe', 'activeLens', 'promptSummary', 'headline', 'coreGuidance', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'domainSlot', 'timeframe', 'activeLens', 'promptSummary', 'headline', 'coreGuidance', 'createdAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && isValidDomainSlot(data.domainSlot)
        && isValidTimeframe(data.timeframe)
        && isValidLens(data.activeLens)
        && data.promptSummary is string && data.promptSummary.size() >= 1 && data.promptSummary.size() <= 500
        && data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 240
        && data.coreGuidance is string && data.coreGuidance.size() >= 1 && data.coreGuidance.size() <= 4000
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLens', 'pdpaAccepted', 'updatedAt'])
        );
      allow delete: if false;

      match /abbotThreads/{threadId} {
        allow get: if isValidId(userId) && isValidId(threadId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(threadId)
          && isOwner(userId)
          && isValidAbbotThread(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(threadId)
          && isOwner(userId)
          && isValidAbbotThread(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'domainSlot', 'depthMode', 'messageCount', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(threadId) && isOwner(userId) && existing().ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow get: if isValidId(userId)
            && isValidId(threadId)
            && isValidId(messageId)
            && isOwner(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/abbotThreads/$(threadId))
            && get(/databases/$(database)/documents/users/$(userId)/abbotThreads/$(threadId)).data.ownerId == request.auth.uid;
          allow list: if isValidId(userId)
            && isValidId(threadId)
            && isOwner(userId)
            && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId)
            && isValidId(threadId)
            && isValidId(messageId)
            && isOwner(userId)
            && isValidAbbotMessage(incoming(), userId, threadId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/abbotThreads/$(threadId))
            && get(/databases/$(database)/documents/users/$(userId)/abbotThreads/$(threadId)).data.ownerId == request.auth.uid;
          allow update: if false;
          allow delete: if isValidId(userId)
            && isValidId(threadId)
            && isValidId(messageId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid;
        }
      }

      match /savedReadings/{readingId} {
        allow get: if isValidId(userId) && isValidId(readingId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(readingId)
          && isOwner(userId)
          && isValidSavedReading(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(readingId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
